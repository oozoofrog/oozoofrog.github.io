---
import "@fontsource/caveat-brush/latin-400.css";
import "@fontsource/gaegu/korean-700.css";
import "@fontsource/gowun-batang/korean-400.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import LunarIllustration from "../components/LunarIllustration.astro";
import ProjectThumbnail from "../components/ProjectThumbnail.astro";
import JournalCover from "../components/JournalCover.astro";
import { getCollection } from "astro:content";
import { projects } from "../data/projects";
import { displayDate, postCategory } from "../data/posts";
const featured = projects.filter((p) => p.featured);
const posts = (
  await getCollection("blog", ({ data }) => data.public !== false)
).sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout fullWidth title="최근 글 · 우주개구리" description="Swift와 iOS 개발, 개발 도구에 관한 글과 실험 기록.">
  <div class="journal-home">
    <section aria-labelledby="journal">
      <header class="section-head">
        <h1 id="journal">최근 글</h1>
        <a href="/blog/">전체 글 {posts.length}편</a>
      </header>
      <ul class="records">
        {posts.slice(0, 3).map((post) => (
          <li>
            <article class="record">
              <div>
                <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
                {post.data.summary && <p>{post.data.summary}</p>}
                <div class="record-meta">
                  <time datetime={post.data.date.toISOString()}>{displayDate(post.data.date)}</time>
                  <span>{postCategory(post.id).label}</span>
                </div>
              </div>
              {post.data.cover && <div class="visual"><JournalCover {...post.data.cover} /></div>}
            </article>
          </li>
        ))}
      </ul>
    </section>
    <section class="projects" aria-labelledby="project-title">
      <header class="section-head">
        <h2 id="project-title">프로젝트</h2>
        <a href="/projects/">전체 프로젝트</a>
      </header>
      <div class="project-index">
        {featured.map((project) => (
          <details class="project-entry">
            <summary>
              <span class="identity">
                <img class="icon" src={project.icon} width="34" height="34" alt="" loading="lazy" />
                <span class="project-name">{project.name}</span>
                <span class="status">{{released:"출시",development:"개발 중",opensource:"오픈 소스"}[project.status]}</span>
                <span class="plus" aria-hidden="true"></span>
              </span>
              <ProjectThumbnail slug={project.slug} screens={project.screens} />
            </summary>
            <div class="project-body">
              <p>{project.description}</p>
              <p class="tags">{project.tags.join(" · ")}</p>
              <div class="project-links">
                {project.page && <a href={project.page}>자세히 보기</a>}
                {project.appstore && <a href={project.appstore}>App Store</a>}
                {project.github && <a href={project.github}>GitHub</a>}
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>
    <LunarIllustration />
  </div>
</BaseLayout>
<style>
  .journal-home {
    max-width: 1120px;
    margin: auto;
    padding: clamp(20px, 4vw, 50px) var(--gutter) 48px;
  }
  .records { list-style: none; }
  .record {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 4vw, 50px);
    padding: clamp(18px, 2.6vw, 30px) 0;
    border-bottom: 1px solid var(--surface-border);
  }
  .record h2 {
    font: 700 clamp(1.18rem, 2.1vw, 1.65rem)/1.45 var(--reading);
    letter-spacing: -.045em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .records li:first-child h2 { font-size: clamp(1.45rem, 3.3vw, 2.45rem); }
  .record h2 a { color: var(--ink); }
  .record h2 a::after { content: ""; position: absolute; inset: 0; }
  .record p { margin-top: 6px; font-size: 1rem; line-height: 1.65; text-wrap: pretty; }
  .record-meta { display: flex; gap: 12px; align-items: center; margin-top: 9px; color: var(--muted); font: .78rem/1.4 var(--sans); }
  .record-meta span { border-left: 1px solid var(--surface-border); padding-left: 12px; }
  .visual { flex: 0 0 clamp(100px, 14vw, 155px); }
  .projects { margin-top: clamp(40px, 6vw, 72px); }
  @media (max-width: 600px) {
    .record { align-items: start; flex-direction: column; gap: 10px; }
    .visual { flex: none; width: 100px; }
  }
  :global(body:has(.journal-home)) {
    --paper:#f7ecd7; --ink:#29291f; --muted:#524b3f; --surface-border:#bbab91;
    --surface-bg:#faf1df; --frog-green:#214973; --frog-green-dark:#203e5c;
    --reading:"Gowun Batang","AppleMyungjo",Georgia,serif;
    --hand:"Gaegu","Apple SD Gothic Neo",sans-serif;
    --brush:"Caveat Brush",var(--hand);
    font-family:var(--reading);
    background:var(--paper);
  }
  :global(body:has(.journal-home) .masthead) {
    background:var(--paper);
    border-bottom-color:#aa977a84;
  }
  :global(body:has(.journal-home) .masthead .wordmark) { font:400 2.05rem/1 var(--brush); letter-spacing:-.04em; }
  :global(body:has(.journal-home) .masthead nav a),
  :global(body:has(.journal-home) .masthead .rss) { font:700 1.24rem/1.15 var(--hand); }
  :global(body:has(.journal-home) .site-footer) {
    margin:0; background:#eee1c6; border-color:#ac9978;
  }
  :global(body:has(.journal-home) .footer-links) { font:700 1.08rem/1.4 var(--hand); }
  .section-head { border-color: #9f8d71; margin-bottom: 0; padding-bottom: 8px; }
  .section-head h1, .section-head h2 { margin: 0; font: 700 clamp(1.5rem, 2.4vw, 2rem)/1.2 var(--hand); }
  .section-head a { font: 700 1.1rem/1.2 var(--hand); }
  .project-index { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px 24px; align-items:start; }
  .project-entry { border-bottom:1px solid var(--surface-border); }
  summary { display:block; cursor:pointer; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  .identity { display:flex; align-items:center; gap:8px; min-height:61px; }
  .icon { width:34px; height:34px; border-radius:8px; flex:none; }
  .project-name { font:400 clamp(1.55rem,2.4vw,1.93rem)/1.1 var(--brush); letter-spacing:-.035em; }
  .status { margin-left:auto; font:700 1.03rem/1.2 var(--hand); color:var(--muted); }
  .plus { display:grid; place-items:center; width:17px; height:17px; color:#47627a; }
  .plus::before,.plus::after { content:""; grid-area:1/1; width:11px; height:1.4px; background:currentColor; }
  .plus::after { transform:rotate(90deg); }
  details[open] .plus::after { transform:rotate(0); }
  summary:hover .project-name,summary:focus-visible .project-name { color:#244d78; }
  .project-body { padding:0 5px 16px; font-size:.9rem; }
  .tags { font:700 .98rem/1.5 var(--hand); color:var(--muted); margin-top:7px; }
  .project-links { display:flex; flex-wrap:wrap; gap:13px; }
  .project-links a { margin-top:9px; font-size:.81rem; font-weight:650; }
  @media(prefers-reduced-motion:no-preference) {
    :global(html[data-motion="playing"]) .plus::after { transition:transform .25s; }
    :global(html[data-motion="playing"]) details[open] .project-body { animation:unfold .28s ease-out; }
  }
  @keyframes unfold { from { opacity:.35; transform:translateY(-5px); } }
  @media(min-width:721px) and (max-width:1000px) {
    .project-index { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media(max-width:720px) {
    .project-index { grid-template-columns:1fr; }
  }
</style>
