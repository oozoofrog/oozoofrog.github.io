---
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments.astro";
import AdUnit from "../components/AdUnit.astro";

interface Props {
  headings: { slug: string; text: string }[];
  title: string;
  date: string | Date;
  categories?: string | string[];
  description?: string;
  noindex?: boolean;
  image?: string;
}
const {
  headings,
  title,
  date,
  categories: rawCategories,
  description,
  noindex = false,
  image,
} = Astro.props;
const categories = Array.isArray(rawCategories)
  ? rawCategories
  : typeof rawCategories === "string"
    ? rawCategories.split(/\s+/).filter(Boolean)
    : [];

const canonicalUrl = Astro.url?.toString();
const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://oozoofrog.dev";
const ogImage = image ?? `${siteUrl}/assets/images/og-default.png`;
const publishedDate = new Date(date);
const publishedDateIso = publishedDate.toISOString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description ?? `${title} - oozoofrog 기술 블로그`,
  image: ogImage,
  datePublished: publishedDateIso,
  dateModified: publishedDateIso,
  author: {
    "@type": "Person",
    name: "oozoofrog",
    url: `${siteUrl}/about/`,
  },
  publisher: {
    "@type": "Organization",
    name: "oozoofrog",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/assets/images/avatar.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  ...(categories.length > 0 && { keywords: categories.join(", ") }),
};
---

<BaseLayout
  title={`${title} | 우주개구리`}
  description={description}
  noindex={noindex}
  image={ogImage}
  type="article"
  publishedDate={publishedDateIso}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <a class="back" href="/blog/">
      전체 글
    </a>
    <div class="article-intro">
      <h1>{title}</h1>

      <p class="post-meta">
        <time datetime={publishedDateIso}>
          {publishedDate.toLocaleDateString("ko-KR", {
            timeZone: "Asia/Seoul",
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        {categories.length > 0 && (
          <span class="post-categories">
            {categories.map((cat) => (
              <span class="tag">{cat}</span>
            ))}
          </span>
        )}
      </p>
    </div>
    {headings.length > 1 && (
      <details class="toc">
        <summary>목차 · {headings.length}개 항목</summary>
        <nav aria-label="글 목차">
          <ol>
            {headings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}
    <div class="post-content">
      <slot />
    </div>
    <AdUnit slot="7941837952" format="auto" />
    <Comments />
  </article>
</BaseLayout>

<style>
  article {
    max-width: 780px;
    margin: 0 auto;
    padding: 12px 0 30px;
  }
  .back {
    display: inline-block;
    font-size: 0.85rem;
    margin-bottom: 25px;
  }
  .article-intro {
    border-bottom: 1px solid #9da597;
    padding-bottom: 25px;
    margin-bottom: 25px;
  }
  .article-intro h1 {
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    line-height: 1.25;
    margin: 10px 0;
    letter-spacing: -0.06em;
    word-break: keep-all;
    overflow-wrap: anywhere;
    color: var(--ink);
  }
  .toc {
    border-block: 1px solid var(--surface-border);
    padding: 12px 0;
    margin-bottom: 22px;
  }
  .toc summary {
    font-size: 0.9rem;
    cursor: pointer;
    font-weight: 650;
  }
  .toc ol {
    padding: 10px 0 5px 1.6rem;
  }
  .toc li {
    padding: 2px 0;
  }
  .post-meta {
    color: var(--muted);
    font-size: 0.9em;
    margin-bottom: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .post-categories {
    display: flex;
    gap: 6px;
  }

  :global(.post-content) {
    font-size: 1.065rem;
    overflow-wrap: anywhere;
    color: var(--ink);
  }

  :global(.post-content > * + *) {
    margin-top: 1rem;
  }

  :global(.post-content h1),
  :global(.post-content h2),
  :global(.post-content h3),
  :global(.post-content h4) {
    color: var(--dark-green);
    line-height: 1.35;
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
  }

  :global(.post-content h1) {
    font-size: 1.9rem;
  }
  :global(.post-content h2) {
    font-size: 1.55rem;
  }
  :global(.post-content h3) {
    font-size: 1.25rem;
  }
  :global(.post-content h4) {
    font-size: 1.05rem;
  }

  :global(.post-content p),
  :global(.post-content li),
  :global(.post-content blockquote) {
    line-height: 1.9;
  }

  :global(.post-content a) {
    text-decoration: underline;
    text-decoration-thickness: 1.2px;
    text-underline-offset: 3px;
  }

  :global(.post-content ul),
  :global(.post-content ol) {
    margin: 1rem 0 1rem 1.25rem;
    padding-left: 1rem;
  }

  :global(.post-content li + li) {
    margin-top: 0.4rem;
  }

  :global(.post-content strong) {
    color: var(--ink);
    font-weight: 700;
  }

  :global(.post-content code) {
    background: var(--surface-bg);
    border: 1px solid var(--surface-border);
    padding: 0.14rem 0.4rem;
    border-radius: 6px;
    font-size: 0.9em;
  }

  :global(.post-content pre) {
    background: #0f1720;
    color: #eaf2ef;
    padding: 1rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 1.2rem 0;
  }

  :global(.post-content pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    border-radius: 0;
    color: inherit;
  }

  :global(.post-content blockquote) {
    border-left: 4px solid var(--frog-green);
    padding: 0.45rem 0 0.45rem 0.9rem;
    color: #42544d;
    background: var(--surface-bg);
    border-radius: 0 8px 8px 0;
    margin: 1.2rem 0;
  }

  :global(.post-content hr) {
    border: 0;
    border-top: 1px solid #dbe6e1;
    margin: 1.6rem 0;
  }

  :global(.post-content img) {
    border-radius: 10px;
    margin: 1rem 0;
  }

  :global(.post-content table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.2rem 0;
    font-size: 0.96em;
    background: var(--surface-bg);
    border-radius: 10px;
    overflow: hidden;
    display: block;
    overflow-x: auto;
  }

  :global(.post-content th),
  :global(.post-content td) {
    border: 1px solid #dbe6e1;
    padding: 0.55rem 0.7rem;
    text-align: left;
  }

  :global(.post-content th) {
    background: var(--surface-bg);
    color: #2b3a33;
  }

  @media (max-width: 720px) {
    article {
      padding: 8px 0;
    }

    h1 {
      font-size: 1.65rem;
    }

    :global(.post-content) {
      font-size: 1rem;
    }
  }
</style>
