---
import type { Project } from "../data/projects";
import { projectStudies } from "../data/plates";
import StudyPlate from "./StudyPlate.astro";
const {
  name,
  slug,
  tagline,
  description,
  status,
  icon,
  tags,
  appstore,
  github,
  page,
} = Astro.props as Project;
const statusLabels = {
  released: "출시",
  development: "개발 중",
  opensource: "오픈 소스",
};
---

<article class="project-card">
  <div class="project-plate">
    <StudyPlate
      kind={projectStudies[slug] ?? "knot"}
      label={slug.toUpperCase()}
    />
  </div>
  <div class="info">
    <div class="identity">
      {icon && <img src={icon} alt="" width="34" height="34" loading="lazy" />}
      <h3>{name}</h3>
      <small>{statusLabels[status]}</small>
    </div>
    <p class="tagline">{tagline}</p>
    <p>{description}</p>
    <div class="tags">
      {tags.map((tag) => (
        <span>{tag}</span>
      ))}
    </div>
    {(page || appstore || github) && (
      <div class="links">
        {page && <a href={page}>자세히 보기 →</a>}
        {appstore && <a href={appstore}>App Store ↗</a>}
        {github && <a href={github}>GitHub ↗</a>}
      </div>
    )}
  </div>
</article>
<style>
  .project-card {
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .project-plate {
    height: 145px;
    border-bottom: 1px solid var(--surface-border);
  }
  .info {
    padding: 18px;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    flex: 1;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    width: 100%;
    line-height: 1.2;
  }
  .identity img {
    border-radius: 8px;
  }
  .identity h3 {
    font: 600 1.28rem var(--serif);
  }
  small {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.75rem;
  }
  p {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .tagline {
    margin: 14px 0 4px;
    color: var(--ink);
    font-weight: 600;
  }
  .tags,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags {
    margin: 12px 0;
    color: var(--muted);
    font: 10px/1.5 var(--mono);
  }
  .tags span {
    border: 1px solid var(--surface-border);
    padding: 1px 5px;
  }
  .links {
    margin-top: auto;
    gap: 12px;
  }
  .links a {
    font-size: 0.82rem;
    font-weight: 650;
  }
</style>
