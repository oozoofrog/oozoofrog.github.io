---
import {
  cardKeeperAppStoreUrl,
  cardKeeperLocales,
  cardKeeperPath,
  cardKeeperRelease,
  type CardKeeperPageContent,
} from '../data/cardKeeperPage';

interface Props {
  content: CardKeeperPageContent;
}

const { content } = Astro.props;
const supportHref = cardKeeperPath('support/', content.locale);
const privacyHref = cardKeeperPath('privacy/', content.locale);
const phoneScreens = content.screens.filter((screen) => screen.device === 'iPhone');
const macScreens = content.screens.filter((screen) => screen.device === 'Mac');
const platforms = content.platforms.filter((platform) => platform.device !== 'Mac' || cardKeeperRelease.mac);
---

<div class="ck-page">
  <header class="ck-hero">
    <nav class="locale-switch" aria-label={content.localeNavLabel}>
      {cardKeeperLocales.map((item) => (
        <a
          href={cardKeeperPath('', item.locale)}
          class:list={['locale-pill', item.locale === content.locale && 'is-active']}
          hreflang={item.lang}
          lang={item.lang}
          aria-current={item.locale === content.locale ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="ck-title-row">
      <img src="/cards/images/card-keeper-icon.png" alt="" width="256" height="256" class="ck-icon" />
      <div>
        <h1>Card Keeper</h1>
        <p class="ck-subtitle">{content.subtitle}</p>
      </div>
    </div>

    <p class="ck-lead">{content.lead}</p>

    {cardKeeperRelease.ios && (
      <div class="ck-actions">
        <a
          href={cardKeeperAppStoreUrl}
          class="ck-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={content.appStoreAriaLabel}
        >{content.appStoreLabel}</a>
      </div>
    )}

    <ul class="ck-platforms" aria-label={content.platformsLabel}>
      {platforms.map((platform) => <li>{platform.label}</li>)}
    </ul>
  </header>

  <section class="ck-section" aria-labelledby="ck-features">
    <h2 id="ck-features">{content.featuresTitle}</h2>
    <div class="ck-feature-grid">
      {content.features.map((feature) => (
        <article class="ck-feature">
          <div class="ck-feature-icon" aria-hidden="true">{feature.icon}</div>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
          {feature.note && <p class="ck-note">{feature.note}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="ck-section" aria-labelledby="ck-screens">
    <h2 id="ck-screens">{content.screensTitle}</h2>
    {content.screensNote && <p class="ck-screens-note">{content.screensNote}</p>}
    <div class="ck-phone-grid">
      {phoneScreens.map((screen) => (
        <figure class="ck-shot">
          <img src={screen.src} alt={screen.alt} width={screen.width} height={screen.height} loading="lazy" decoding="async" />
          <figcaption><span class="ck-device">{screen.device}</span>{screen.caption}</figcaption>
        </figure>
      ))}
    </div>
    {macScreens.map((screen) => (
      <figure class="ck-shot ck-shot-mac">
        <img src={screen.src} alt={screen.alt} width={screen.width} height={screen.height} loading="lazy" decoding="async" />
        <figcaption><span class="ck-device">{screen.device}</span>{screen.caption}</figcaption>
      </figure>
    ))}
  </section>

  <nav class="ck-footer-links" aria-label="Card Keeper">
    <a href={supportHref}>{content.supportLabel}</a>
    <span class="separator" aria-hidden="true">·</span>
    <a href={privacyHref}>{content.privacyLabel}</a>
  </nav>
</div>

<style>
  .ck-page {
    --ck-ink: #3f1c27;
    --ck-red: #9e3147;
    --ck-text: #5d4650;
    --ck-border: rgba(255, 255, 255, 0.6);
    --ck-shadow: 0 14px 40px rgba(76, 31, 41, 0.1);
    max-width: 960px;
    margin: 0 auto;
  }

  .ck-hero,
  .ck-feature,
  .ck-shot {
    border: 1px solid var(--ck-border);
    box-shadow: var(--ck-shadow);
  }

  .ck-hero {
    padding: 40px;
    margin-bottom: 40px;
    border-radius: 28px;
    background: var(--surface-bg);
  }

  .locale-switch {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: 24px;
  }

  .locale-pill {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    color: #714855;
    border: 1px solid rgba(158, 49, 71, 0.08);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .locale-pill.is-active {
    background: linear-gradient(135deg, var(--ck-red), #bf4960);
    color: #fff;
  }

  .locale-pill:hover {
    border-bottom: 1px solid transparent;
    color: var(--ck-red);
  }

  .locale-pill.is-active:hover {
    color: #fff;
  }

  .ck-title-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 18px;
  }

  .ck-icon {
    width: 104px;
    height: 104px;
    border-radius: 24px;
    flex-shrink: 0;
    box-shadow: 0 14px 30px rgba(52, 72, 200, 0.22);
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    color: var(--ck-ink);
    margin: 0 0 8px;
  }

  .ck-subtitle {
    color: var(--ck-red);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .ck-lead {
    max-width: 720px;
    color: var(--ck-text);
    font-size: 1.06rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .ck-actions {
    margin-bottom: 20px;
  }

  .ck-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-weight: 700;
    border: 1px solid transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ck-btn:visited,
  .ck-btn:hover {
    color: #fff;
  }

  .ck-btn:hover {
    transform: translateY(-2px);
    border-bottom: 1px solid transparent;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
  }

  .ck-btn:focus-visible,
  .locale-pill:focus-visible,
  .ck-footer-links a:focus-visible {
    outline: 3px solid var(--ck-red);
    outline-offset: 3px;
  }

  .ck-platforms {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ck-platforms li {
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(158, 49, 71, 0.1);
    color: #714855;
    font-size: 0.92rem;
  }

  .ck-section {
    margin-bottom: 40px;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--ck-ink);
    margin-bottom: 18px;
  }

  .ck-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .ck-feature {
    padding: 22px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.75);
  }

  .ck-feature-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(243, 154, 114, 0.22), rgba(158, 49, 71, 0.12));
    font-size: 1.4rem;
    margin-bottom: 14px;
  }

  h3 {
    color: var(--ck-ink);
    font-size: 1.06rem;
    margin-bottom: 8px;
  }

  .ck-feature p {
    color: var(--ck-text);
    font-size: 0.97rem;
  }

  .ck-feature .ck-note {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #eadfe2;
    font-size: 0.9rem;
  }

  .ck-screens-note {
    color: var(--ck-text);
    margin: -8px 0 16px;
  }

  .ck-phone-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }

  .ck-shot {
    margin: 0;
    padding: 12px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.75);
  }

  .ck-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid rgba(63, 28, 39, 0.08);
  }

  .ck-shot figcaption {
    padding: 10px 4px 2px;
    color: var(--ck-text);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .ck-device {
    display: block;
    color: var(--ck-red);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .ck-footer-links {
    text-align: center;
    padding: 8px 0 4px;
  }

  .ck-footer-links a {
    color: var(--ck-red);
    display: inline-block;
    padding: 6px 10px;
  }

  .ck-footer-links a:hover {
    color: var(--ck-ink);
  }

  .separator {
    margin: 0 4px;
    color: rgba(144, 112, 123, 0.7);
  }

  @media (max-width: 900px) {
    .ck-feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ck-phone-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .ck-hero {
      padding: 24px 18px;
      border-radius: 22px;
    }

    .locale-switch {
      justify-content: flex-start;
    }

    .ck-title-row {
      gap: 14px;
    }

    h1 {
      font-size: 2rem;
    }

    .ck-icon {
      width: 80px;
      height: 80px;
      border-radius: 18px;
    }

    .ck-btn {
      width: 100%;
      justify-content: center;
    }

    .ck-feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
