---
interface Props { count: number; yearRange: string }
const { count, yearRange } = Astro.props;
const scenes = [
  { format: "wide", box: "0 0 1902 827", moon: "1036 124", comet: "802 341", star: "1101 387", glint: "M1211 381q20-68 95-94m12-3 19-4" },
  { format: "portrait", box: "0 0 1086 1448", moon: "992 410", comet: "542 665", star: "898 650", glint: "M615 868q21-69 98-101m13-3 18-4" },
];
---
<section class="cover" aria-labelledby="pond-title" data-cover data-view="wide">
  <div class="spread">
    <div class="camera">
      <picture>
        <source media="(max-width:600px)" srcset="/assets/images/lunar-portrait.webp"/>
        <img src="/assets/images/lunar-panorama.webp" width="1902" height="827" fetchpriority="high"
          alt="우주복을 입은 개구리가 달에 앉아 지구를 올려다본다. 발자국이 바위와 황금빛 풀 사이로 이어진다."/>
      </picture>
      {scenes.map(scene => (
        <svg class:list={["cels",scene.format]} viewBox={scene.box} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <g transform={`translate(${scene.moon})`}>
            <g class="moon"><path d="m-91 27 2-5 3 2-1 4-3 2z" fill="#51432e"/></g>
          </g>
          <g transform={`translate(${scene.comet})`}>
            <g class="comet" stroke-linecap="round">
              <path d="M0 0q33-20 90-61m-66 51 54-37" fill="none" stroke="#85683f" stroke-width="2"/>
              <path d="m88-62 3-9 2 8 7 1-8 4-3 6-1-6-5-1z" fill="#283b50"/>
            </g>
          </g>
          <g transform={`translate(${scene.star})`}>
            <path class="star" fill="#967035" d="m0-9 2 7 8 2-8 2-2 9-2-9-7-2 7-2z"/>
          </g>
          <path class="glint" d={scene.glint} fill="none" stroke="#fff8d9" stroke-width="6" stroke-linecap="round" pathLength="1"/>
        </svg>
      ))}
    </div>
    <div class="intro">
      <p class="byline">우주개구리의 개발 일지</p>
      <h1 id="pond-title" lang="en">Orbital <em>Pond<span>.</span></em></h1>
      <p class="description">Swift와 iOS, 그리고 개발 도구를 만드는<br/>우주개구리의 실험과 기록.</p>
      <div class="actions">
        <a class="primary" href="/blog/">글 둘러보기 <span aria-hidden="true">↗</span></a>
        <a class="secondary" href="/projects/">프로젝트 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
  <div class="colophon">
    <div class="archive"><span class="years">{yearRange}</span><a href="/blog/">기록 {count}편 ↗</a></div>
    <div class="view-controls" hidden role="group" aria-label="그림 확대 보기">
      {([["wide","전경"],["frog","개구리"],["earth","지구"]] as const).map(([key,label]) => (
        <button type="button" data-shot={key} aria-pressed={key === "wide"}>{label}</button>
      ))}
    </div>
    <button type="button" class="play" data-motion hidden><i aria-hidden="true"></i><span>움직임 멈추기</span></button>
  </div>
</section>
<script>
  const cover = document.querySelector<HTMLElement>("[data-cover]")!;
  const page = document.documentElement;
  const preference = matchMedia("(prefers-reduced-motion: reduce)");
  const motion = cover.querySelector<HTMLButtonElement>("[data-motion]")!;
  const shots = cover.querySelectorAll<HTMLButtonElement>("[data-shot]");
  function setMotion(paused: boolean) {
    page.dataset.motion = paused ? "paused" : "playing";
    motion.querySelector("span")!.textContent = paused ? "움직임 재생" : "움직임 멈추기";
  }
  setMotion(preference.matches);
  motion.hidden = false;
  motion.addEventListener("click", () => setMotion(page.dataset.motion === "playing"));
  preference.addEventListener("change", () => setMotion(preference.matches));
  new IntersectionObserver(([entry]) => {
    cover.toggleAttribute("data-offscreen", !entry.isIntersecting);
  }).observe(cover);
  cover.querySelector<HTMLElement>(".view-controls")!.hidden = false;
  for (const shot of shots) {
    shot.addEventListener("click", () => {
      cover.dataset.view = shot.dataset.shot;
      for (const other of shots) other.setAttribute("aria-pressed", String(other === shot));
    });
  }
</script>
<style>
  .cover { color:var(--ink); }
  .spread {
    position:relative; isolation:isolate; overflow:hidden; display:grid;
    align-content:start; min-height:clamp(380px,43.48vw,860px);
    background:#f2e5ce;
  }
  .camera,.camera picture,.camera img,.cels { position:absolute; inset:0; width:100%; height:100%; display:block; }
  .camera { z-index:-2; }
  .camera img { object-fit:cover; }
  .cels { pointer-events:none; }
  .cels.portrait { display:none; }
  .cover[data-view="frog"] .camera { transform-origin:73% 63%; transform:scale(1.6); }
  .cover[data-view="earth"] .camera { transform-origin:96% 0%; transform:scale(1.65); }
  .spread::after {
    content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; opacity:0;
    background:linear-gradient(95deg,#f6ead7 6%,#f6ead7ef 32%,transparent 61%);
  }
  .cover:not([data-view="wide"]) .spread::after { opacity:.94; }
  .intro { width:min(1320px,100%); margin:0 auto; padding:clamp(40px,7.1vw,118px) var(--gutter) 28px; }
  .byline { font:700 clamp(1.1rem,1.6vw,1.6rem)/1.25 var(--hand); color:#504332; }
  h1 { width:fit-content; margin:.07em 0 .21em; transform:rotate(-2deg); font:400 clamp(4.75rem,8.6vw,9.1rem)/.94 var(--brush); letter-spacing:-.055em; }
  h1 em { margin-left:.08em; font-style:normal; color:#244e7c; }
  h1 span { color:#ab701f; }
  .description { font:400 clamp(.97rem,1.32vw,1.22rem)/1.55 var(--reading); color:#302c24; }
  .actions { display:flex; align-items:center; gap:24px; margin-top:clamp(12px,1.4vw,23px); }
  .actions a { position:relative; display:inline-flex; align-items:center; gap:12px; font:700 clamp(1.15rem,1.6vw,1.42rem)/1.1 var(--hand); }
  .primary,.primary:visited { color:#fff9e9; padding:10px 19px 11px; }
  .primary::before {
    content:""; position:absolute; z-index:-1; inset:0; background:#254b70;
    clip-path:polygon(1% 12%,11% 6%,63% 2%,91% 4%,99% 0,97% 15%,100% 23%,98% 59%,99% 85%,92% 89%,98% 94%,50% 98%,2% 100%,3% 88%,0 84%,2% 32%);
  }
  .secondary,.secondary:visited { color:#302e26; }
  .actions a:hover span { transform:translate(2px,-1px); }
  .colophon { display:flex; align-items:center; gap:18px; flex-wrap:wrap; padding:7px max(var(--gutter),calc((100% - 1320px)/2 + var(--gutter))); border-block:1px solid #8e78585c; background:#f3e8d2; color:#4f4535; font:700 1.04rem/1.2 var(--hand); }
  .archive,.view-controls,.play { display:flex; align-items:center; gap:12px; }
  .archive { margin-right:auto; }
  .years { padding-right:12px; border-right:1px solid #b9a98b; }
  .colophon a,.colophon a:visited { color:inherit; }
  button { color:inherit; background:transparent; cursor:pointer; font:inherit; }
  .view-controls { gap:2px; }
  .view-controls button { padding:1px 11px; min-height:32px; border:1px solid transparent; border-radius:56% 43% 51% 40%; }
  .view-controls button[aria-pressed="true"] { color:#23466d; border-color:#426284; }
  .view-controls button:hover,.play:hover { text-decoration:underline; }
  .play { gap:6px; min-height:34px; border:none; }
  .play i { height:10px; width:8px; border-inline:2px solid currentColor; }
  :global(html[data-motion="paused"]) .play i { height:0; border:5px solid transparent; border-left:8px solid currentColor; border-right:0; }
  [hidden] { display:none; }
  .moon { animation:orbit 14s linear infinite; }
  .comet { animation:comet-pass 8s ease-in-out infinite; opacity:0; }
  .glint { stroke-dasharray:1; animation:visor 7s ease-in-out infinite; opacity:0; }
  .star { animation:twinkle 4s ease-in-out infinite; }
  .cels * { animation-play-state:paused; }
  :global(html[data-motion="playing"]) .cover:not([data-offscreen]) .cels * { animation-play-state:running; }
  @keyframes orbit { to { transform:rotate(360deg); } }
  @keyframes comet-pass { 0%,48% { opacity:0; transform:translate(-55px,40px); } 54% { opacity:.88; } 68%,100% { opacity:0; transform:translate(75px,-53px); } }
  @keyframes visor { 0%,28% { opacity:0; stroke-dashoffset:1; } 40% { opacity:.88; } 59%,100% { opacity:0; stroke-dashoffset:0; } }
  @keyframes twinkle { 0%,100% { opacity:.16; transform:scale(.6); } 50% { opacity:.9; transform:scale(1.1); } }
  @media(prefers-reduced-motion:no-preference) {
    :global(html[data-motion="playing"]) .camera { transition:transform 1.1s cubic-bezier(.22,.72,.18,1); }
    :global(html[data-motion="playing"]) .spread::after { transition:opacity .65s; }
  }
  @media(max-width:820px) and (min-width:601px) {
    .intro { padding-top:19px; }
    h1 { font-size:5rem; } .actions { margin-top:10px; }
  }
  @media(max-width:600px) {
    .spread { min-height:0; aspect-ratio:3/4; }
    .intro { padding:clamp(20px,6vw,35px) var(--gutter) 8px; }
    h1 { font-size:clamp(3.5rem,13.4vw,5rem); margin:4px 0 9px; }
    h1 em { margin-left:.08em; }
    .description { font-size:clamp(.94rem,3.6vw,1.12rem); }
    .actions { gap:17px; margin-top:13px; }
    .actions a { font-size:1.15rem; }
    .primary { padding:8px 13px 10px; }
    .cels.wide { display:none; } .cels.portrait { display:block; }
    .cover[data-view="frog"] .camera { transform-origin:74% 75%; }
    .spread::after { background:linear-gradient(#f7ead6f5 10%,#f7ead6e6 33%,transparent 59%); }
    .colophon { gap:2px 9px; justify-content:space-between; padding-block:5px; }
    .archive { margin:0; }
    .years { display:none; }
    .view-controls button { padding-inline:6px; }
    .play { font-size:.94rem; }
  }
</style>
