---
import {skyNotes} from "../graphics/lunar-sky";
const artwork = "/assets/images/lunar-journal.webp";
---
<figure class="studio" data-portrait-studio>
  <div class="stage">
    <div class="registration" data-registration><noscript><img src={artwork} width="1254" height="1254" alt="달에 앉아 지구를 보는 우주개구리" /></noscript><img hidden src={artwork} width="1254" height="1254" alt="우주복을 입은 개구리가 달에 앉아 지구를 바라보는 그림" />
    </div>
    <canvas hidden tabindex="-1" aria-label="달 표면의 우주개구리와 지구를 담은 3D 장면" role="img"></canvas>
    <button class="moon" data-moon hidden aria-label="작은 달 탐험 시작" title="작은 달 탐험"></button>
  </div>
  <figcaption hidden>
    <div class="toolbar">
      <div class="turn" role="group" aria-label="회전">
        <button type="button" data-zoom aria-pressed="false">확대</button>
        <button type="button" data-step="-1" aria-label="왼쪽으로 돌리기">‹</button>
        <button type="button" data-step="1" aria-label="오른쪽으로 돌리기">›</button>
      </div>
      <button type="button" class="motion" data-motion aria-pressed="true">자동 움직임</button>
    </div>
    <details class="sky-index" hidden>
      <summary>하늘 지도</summary>
      <div class="sky-places">
        {Object.entries(skyNotes).map(([place,[name]])=><button type="button" data-sky={place} aria-pressed="false">{name}</button>)}
      </div>
    </details>
    <div class="flight" data-flight hidden>
      <div class="sites" role="group" aria-label="탐험 장소">
        {Object.entries({relay:"탐사선",comet:"혜성",prints:"달 표면",rover:"월면차"}).map(([key,label])=><button type="button" data-site={key} aria-pressed="false">{label}</button>)}
        <button type="button" data-interact hidden></button>
      </div>
      {Object.entries({forward:"전진",back:"후진",left:"왼쪽",right:"오른쪽",up:"상승",down:"하강"}).map(([key,label])=><button type="button" data-move={key}>{label}</button>)}
      <button type="button" data-land>돌아가기</button>
    </div>
    <p role="status"></p>
  </figcaption>
</figure>
<script>
  const studio = document.querySelector<HTMLElement>("[data-portrait-studio]");
  if (studio) {
    const observer = new IntersectionObserver(async ([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      try {
        const { mountPortrait } = await import("../graphics/portrait");
        await mountPortrait(studio);
      } catch {
        const fallback=studio.querySelector<HTMLImageElement>("[data-registration] > img");
        if(fallback)fallback.hidden=false;
      }
    });
    observer.observe(studio.querySelector(".stage")!);
  }
</script>
<style>
  .studio { grid-column:1; margin:0; align-self:start; min-width:0; pointer-events:none; }
  .stage { position:fixed; inset:0; z-index:0; overflow:hidden; background:var(--paper); pointer-events:auto; }
  .registration {
    --frame:min(59vw,clamp(220px,calc(100svh - 208px),82svh)); position:absolute; width:var(--frame); aspect-ratio:1;
    right:2vw; top:calc(50% - 12px); transform:translateY(-50%); overflow:hidden; border-radius:50%;
    z-index:1; pointer-events:none;
  }
  .registration img { width:100%; height:100%; display:block; }
  .moon { position:absolute; z-index:2; transform:translate(-50%,-50%); width:var(--moon-size,44px); aspect-ratio:1; min-width:28px; border-radius:50%; border:none; }
  .moon:hover, .moon:focus-visible { outline: 2px dashed #745b36; outline-offset: 2px; }
  .flight { display:flex; flex-wrap:wrap; gap:5px; }
  .flight button,.turn button[data-zoom] { font:700 1rem/1.4 var(--journal-font); border:1px solid #c5bcab; padding:4px 9px; border-radius:4px; width:auto; touch-action:manipulation; }
  .turn button[data-zoom][aria-pressed="true"] { background:#e7e0d1; }
  .motion { font:700 1rem/1.4 var(--journal-font); border:1px solid var(--surface-border); border-radius:4px; padding:4px 9px; }
  .motion[aria-pressed="true"] { background:#e7e0d1; }
  canvas { width: 100%; height: 100%; position: absolute; inset: 0; touch-action: pan-y; cursor: grab; }
  canvas:active { cursor: grabbing; }
  figcaption {
    position:relative; z-index:1; pointer-events:auto; width:fit-content; max-width:100%; margin-right:auto;
    padding:10px 0 0; border-top:1px solid #9187768c;
  }
  .sky-index { margin-top:8px; font-size:1.14rem; }
  .sky-index summary { width:fit-content; cursor:pointer; text-decoration:underline; text-underline-offset:4px; }
  .sky-places { display:flex; flex-wrap:wrap; gap:2px 12px; padding-top:5px; }
  .sky-places button { font:inherit; padding:3px 0; }
  .sky-places button[aria-pressed="true"] { text-decoration:underline; color:#214973; }
  .toolbar, .turn { display: flex; align-items: center; }
  .sites { display:flex; flex-wrap:wrap; align-items:center; gap:8px; width:100%; padding-bottom:8px; margin-bottom:4px; border-bottom:1px solid var(--surface-border); }
  .sites button[aria-pressed="true"],.sites button[data-interact] { background:#e7e0d1; }
  .toolbar { flex-wrap:wrap; justify-content: space-between; gap: 8px; }
  button { color: #404846; border: 1px solid transparent; background: transparent; cursor: pointer; }
  .turn { gap: 4px; }
  .turn button { font: 1.5rem/1 var(--journal-font); width: 36px; height: 34px; border-color: #c5bcab; border-radius: 50%; }
  button:hover { color: #192e44; border-color: #827e72; }
  figcaption p { margin-top: 7px; font: .9rem/1.55 var(--journal-font); color: var(--muted); }
  @media(max-width:720px){
    .studio { align-self:stretch; }
    .registration { --frame:min(95vw,48svh); right:50%; top:var(--mobile-art-centre,calc(22svh + 214px)); transform:translate(50%,-50%); }
    figcaption { margin-inline:auto; }
  }
  [hidden],.registration img[hidden] { display:none; }
</style>
