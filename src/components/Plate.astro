---
import type { Study } from "../graphics/studies";
interface Props {
  kind: Study | "pond";
}
const { kind } = Astro.props;
---

<canvas data-study={kind} aria-hidden="true"></canvas>
<script>
  import { mountGallery } from "../graphics/viewer";
  mountGallery();
</script>
<style>
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    position: absolute;
    inset: 0;
  }
</style>
